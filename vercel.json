{
  "headers": [
    {
      "source": "/(.*).pdf",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Range" },
        { "key": "Access-Control-Expose-Headers", "value": "Accept-Ranges, Content-Encoding, Content-Length, Content-Range" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/pdfs/(.*)", "destination": "/pdfs/$1" },
    { "source": "/interview%20pages/(.*)", "destination": "/interview%20pages/$1" },
    { "source": "/(.*).pdf", "destination": "/$1.pdf" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
